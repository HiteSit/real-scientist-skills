#!/usr/bin/env bash
# Block a push that leaks secrets or private names. Checks only commits that no
# remote-tracking ref has yet (upstream history is skipped).
#   1. gitleaks over those commits (required; https://github.com/gitleaks/gitleaks)
#   2. added lines matched against a private, never-committed pattern list:
#      ${XDG_CONFIG_HOME:-~/.config}/real-scientist-skills/leak-patterns
#      (one case-insensitive extended regex per line, matched as whole words)
set -euo pipefail

patterns="${XDG_CONFIG_HOME:-$HOME/.config}/real-scientist-skills/leak-patterns"
command -v gitleaks >/dev/null || { echo "pre-push: gitleaks not found; refusing to push" >&2; exit 1; }

zero=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha _ _; do
    [ "$local_sha" = "$zero" ] && continue   # deleting a ref
    [ -n "$(git rev-list "$local_sha" --not --remotes)" ] || continue

    if ! gitleaks git --no-banner --redact --log-opts="$local_sha --not --remotes" .; then
        echo "pre-push: gitleaks found secrets" >&2; status=1
    fi

    if [ -s "$patterns" ]; then
        hits=$(git log -p --no-merges --format= "$local_sha" --not --remotes |
            grep '^+' | grep -v '^+++' | grep -inwEf "$patterns" || true)
        if [ -n "$hits" ]; then
            echo "pre-push: private names in added lines:" >&2; echo "$hits" >&2; status=1
        fi
    else
        echo "pre-push: no pattern list at $patterns; private-name check skipped" >&2
    fi
done
[ "$status" -eq 0 ] || echo "pre-push: push blocked. Rewrite the offending commits before pushing." >&2
exit "$status"
